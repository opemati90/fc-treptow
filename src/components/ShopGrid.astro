---
import { getCollection } from 'astro:content';
import { bcp47, defaultLocale, l, type Locale } from '../i18n/languages';
import { useTranslations } from '../i18n/ui';

interface Props {
  limit?: number;
}
const lang = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(lang);
const shopItems = (await getCollection('shop')).map((e) => e.data).sort((a, b) => a.order - b.order);
const { limit = shopItems.length } = Astro.props;
const price = (v: number) => new Intl.NumberFormat(bcp47[lang], { style: 'currency', currency: 'EUR' }).format(v);
---
<ul class="stagger grid grid-cols-2 gap-x-4 gap-y-8 sm:gap-x-6 lg:grid-cols-4">
  {shopItems.slice(0, limit).map((item) => (
    <li>
      <a href={`${l(lang, '/shop')}#${encodeURIComponent(new URL(item.url).pathname.slice(1) + new URL(item.url).search)}`} data-shop-item class="group block" aria-label={`${item.name}, ${price(item.price)}`}>
        <!-- Doppelrahmen: Produkt liegt wie im Schaufenster auf einer Platte -->
        <div class="rounded-[10px] bg-paper-deep p-1.5 ring-1 ring-line">
          <div class="overflow-hidden rounded-sm bg-white shadow-[inset_0_1px_0_rgba(255,255,255,0.8)]">
            <img src={item.image} alt="" width="900" height="900" loading="lazy" decoding="async" class="aspect-square w-full object-contain p-3 transition-transform duration-500 ease-(--ease-club) group-hover:scale-[1.04]" />
          </div>
        </div>
        <div class="mt-3 flex items-start justify-between gap-3 px-0.5">
          <p class="text-sm font-semibold leading-snug">{item.name}</p>
          <p class="nums shrink-0 text-sm text-ink-soft">{price(item.price)}</p>
        </div>
      </a>
    </li>
  ))}
</ul>

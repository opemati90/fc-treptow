---
import PageHeader from '../PageHeader.astro';
import { Content } from '../../legal/datenschutz.md';
import { defaultLocale, type Locale } from '../../i18n/languages';
import { pageT } from '../../i18n/pages';

const lang = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = pageT('datenschutz', lang);
---
<PageHeader title={t.h1}>
  {t.notice && <p class="mt-6 max-w-2xl rounded-sm bg-card p-5 leading-relaxed ring-1 ring-line">{t.notice}</p>}
</PageHeader>

<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <div lang="de" dir="ltr" class="legal max-w-3xl text-base leading-relaxed text-ink-soft [&>h2:first-child]:mt-0">
    <Content />
  </div>
</section>

---
import PageHeader from '../PageHeader.astro';
import Icon from '../Icon.astro';
import { defaultLocale, l, type Locale } from '../../i18n/languages';
import { pageT } from '../../i18n/pages';
import { club } from '../../data/club';

const lang = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = pageT('anmeldung', lang);
const field = 'min-h-12 w-full rounded-sm border border-ink/25 bg-card px-4 py-3 text-base outline-none transition-colors focus:border-ink focus:ring-2 focus:ring-club/25';
const label = 'text-sm font-semibold';
---
<PageHeader title={t.h1} intro={t.intro} />

<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <div class="max-w-3xl">
    <div id="gate" class="border-y border-ink py-10">
      <span class="flex h-12 w-12 items-center justify-center rounded-full bg-ink text-paper"><Icon name="lock" size={22} /></span>
      <h2 class="display mt-6 text-4xl">{t.gateTitle}</h2>
      <p class="mt-3 max-w-md leading-relaxed text-ink-soft">{t.gateText} <a href={l(lang, '/probetraining')} class="font-semibold text-club underline-offset-4 hover:underline">{t.gateLink}</a>.</p>
      <form id="gate-form" class="mt-6 flex max-w-sm gap-2">
        <label for="code" class="sr-only">{t.codePlaceholder}</label>
        <input id="code" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder={t.codePlaceholder} class={`${field} uppercase tracking-[0.2em]`} />
        <button type="submit" class="min-h-12 shrink-0 rounded-full bg-club px-6 text-[15px] font-semibold text-white transition-[background-color,transform] duration-200 hover:bg-club-deep active:scale-[0.97]">{t.gateSubmit}</button>
      </form>
      <p id="gate-error" class="mt-3 hidden text-sm font-semibold text-club" role="alert">{t.gateError}</p>
    </div>

    <form id="reg-form" class="hidden" novalidate>
      <h2 class="display text-4xl">{t.formTitle}</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        <div class="flex flex-col gap-2"><label for="firstname" class={label}>{t.firstname}</label><input id="firstname" name="firstname" type="text" autocomplete="given-name" required class={field} /></div>
        <div class="flex flex-col gap-2"><label for="lastname" class={label}>{t.lastname}</label><input id="lastname" name="lastname" type="text" autocomplete="family-name" required class={field} /></div>
        <div class="flex flex-col gap-2"><label for="birthdate" class={label}>{t.birthdate}</label><input id="birthdate" name="birthdate" type="date" autocomplete="bday" required class={field} /></div>
        <div class="flex flex-col gap-2"><label for="reg-email" class={label}>{t.email}</label><input id="reg-email" name="email" type="email" autocomplete="email" required class={field} /></div>
        <div class="flex flex-col gap-2 sm:col-span-2"><label for="address" class={label}>{t.address}</label><input id="address" name="address" type="text" autocomplete="street-address" required class={field} /></div>
        <div class="flex flex-col gap-2">
          <label for="reg-team" class={label}>{t.team}</label>
          <select id="reg-team" name="team" class={field}>{t.teamOptions.map((o: string) => <option>{o}</option>)}</select>
        </div>
        <div class="flex flex-col gap-2"><label for="lastclub" class={label}>{t.lastclub} <span class="font-normal text-ink-soft">{t.optional}</span></label><input id="lastclub" name="lastclub" type="text" class={field} /></div>
        <div class="flex flex-col gap-2 sm:col-span-2">
          <label for="tariff" class={label}>{t.tariff}</label>
          <select id="tariff" name="tariff" class={field}>{t.tariffOptions.map((o: string) => <option>{o}</option>)}</select>
        </div>
      </div>
      <label class="mt-8 flex items-start gap-3 leading-relaxed text-ink-soft">
        <input type="checkbox" required class="mt-1 h-5 w-5 shrink-0 accent-club" />
        <span>{t.consent} <a href={l(lang, '/datenschutz')} class="font-semibold text-club underline-offset-4 hover:underline">{t.consentLink}</a> {t.consentRest}</span>
      </label>
      <p id="reg-error" class="mt-6 hidden text-sm font-semibold text-club" role="alert" data-validation={t.formError} data-failure={t.sendFailed}>{t.formError}</p>
      <button id="reg-submit" type="submit" data-sending={t.sending} class="group mt-8 inline-flex min-h-12 items-center gap-3 rounded-full bg-club py-1.5 ps-6 pe-1.5 text-[15px] font-semibold text-white transition-[background-color,transform] duration-200 ease-(--ease-club) hover:bg-club-deep active:scale-[0.97] disabled:opacity-60">
        <span data-label>{t.submit}</span>
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white/15 transition-transform duration-300 group-hover:translate-x-0.5"><Icon name="arrow" size={18} /></span>
      </button>
      <p class="mt-6 text-sm leading-relaxed text-ink-soft">{t.footnote} <a href={l(lang, '/downloads')} class="font-semibold text-club underline-offset-4 hover:underline">{t.downloadsLabel}</a>.</p>
    </form>

    <div id="reg-done" class="hidden border-y border-ink py-10" role="status" tabindex="-1">
      <span class="flex h-12 w-12 items-center justify-center rounded-full bg-club text-white"><Icon name="check" size={22} /></span>
      <h2 class="display mt-6 text-4xl" data-sent={t.successTitle} data-mail={t.mailTitle}>{t.successTitle}</h2>
      <p class="mt-3 max-w-md text-lg leading-relaxed text-ink-soft" data-sent={t.successText} data-mail={t.mailText}>{t.successText}</p>
      <p data-mail-only class="mt-6 hidden text-sm text-ink-soft">{t.mailFallback} <a data-mail-link href={`mailto:${club.email}`} class="font-semibold text-club underline underline-offset-4">{t.mailAgain}</a></p>
    </div>
  </div>
</section>

<script>
  import { submitForm } from '../../lib/submitForm';
  import { showDone } from '../../lib/formDone';

  // Der Code wird vom Trainer nach dem Probetraining vergeben. Er hält Neugierige ab,
  // ist aber bewusst keine echte Zugangssperre (steht im Browser-Code).
  const UNLOCK_CODE = 'TREPTOW1925';
  const gate = document.getElementById('gate');
  const gateForm = document.getElementById('gate-form') as HTMLFormElement | null;
  const regForm = document.getElementById('reg-form') as HTMLFormElement | null;

  gateForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const value = (document.getElementById('code') as HTMLInputElement).value.trim().toUpperCase();
    if (value === UNLOCK_CODE) {
      gate?.classList.add('hidden');
      regForm?.classList.remove('hidden');
      (document.getElementById('firstname') as HTMLInputElement | null)?.focus();
    } else {
      document.getElementById('gate-error')?.classList.remove('hidden');
    }
  });

  const err = document.getElementById('reg-error');
  const btn = document.getElementById('reg-submit') as HTMLButtonElement | null;
  const btnLabel = btn?.querySelector('[data-label]');
  const labelText = btnLabel?.textContent ?? '';

  regForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!regForm.checkValidity()) {
      err!.textContent = err!.dataset.validation ?? '';
      err?.classList.remove('hidden');
      (regForm.querySelector(':invalid') as HTMLElement | null)?.focus();
      return;
    }
    err?.classList.add('hidden');
    if (btn) btn.disabled = true;
    if (btnLabel) btnLabel.textContent = btn?.dataset.sending ?? labelText;
    try {
      const result = await submitForm(regForm, 'Neue Anmeldung');
      showDone(regForm, document.getElementById('reg-done'), result);
    } catch {
      err!.textContent = err!.dataset.failure ?? '';
      err?.classList.remove('hidden');
    } finally {
      if (btn) btn.disabled = false;
      if (btnLabel) btnLabel.textContent = labelText;
    }
  });
</script>

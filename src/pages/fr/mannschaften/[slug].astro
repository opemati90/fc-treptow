---
import Base from '../../../layouts/Base.astro';
import Sections from '../../../components/sections/TeamDetailSections.astro';
import { getTeams, leagueLabel, trainingLabel } from '../../../i18n/content';

export async function getStaticPaths() {
  const teams = await getTeams('fr');
  return teams.map((team) => ({ params: { slug: team.slug }, props: { team } }));
}

const { team } = Astro.props;
const d = team.data;
const description = [`${d.name}, ${leagueLabel(d.league, 'fr')}`, ...d.training.map((s) => trainingLabel(s, 'fr'))].join('. ');
---
<Base title={d.name} description={description} image={d.image}>
  <Sections team={team} />
</Base>

---
import Base from '../../layouts/Base.astro';
import Sections from '../../components/sections/ShopItemSections.astro';
import { getCollection } from 'astro:content';
import { pageT } from '../../i18n/pages';

export async function getStaticPaths() {
  const items = await getCollection('shop');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const t = pageT('shop', 'de');
---
<Base title={`${item.data.name} | ${t.metaTitle}`} description={`${item.data.name}, ${item.data.price.toFixed(2).replace('.', ',')} €. ${t.metaDesc}`} image={item.data.image}>
  <Sections item={item} />
</Base>
